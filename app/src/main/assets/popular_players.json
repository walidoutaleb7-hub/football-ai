# =========================================================
# تنظيف الاسم
# =========================================================

def normalize_name(name):
    name = name.strip()
    name = re.sub(r"\s+", " ", name)
    return name


# =========================================================
# حذف التكرارات
# =========================================================

final_players = []
seen_names = set()

for item in data:

    name, nationality, level, position, status = item

    name = normalize_name(name)

    key = name.casefold()

    if key in seen_names:
        print(f"⚠️ تم تجاهل لاعب مكرر: {name}")
        continue

    seen_names.add(key)

    final_players.append({
        "name": name,
        "nationality": nationality,
        "level": level,
        "position": position,
        "status": status
    })


# =========================================================
# إنشاء IDs ثابتة
# =========================================================

for i, player in enumerate(final_players, 1):
    player["id"] = i


# =========================================================
# ترتيب عشوائي
# =========================================================

random.shuffle(final_players)


# =========================================================
# إنشاء JSON النهائي
# =========================================================

result = []

for player in final_players:

    result.append({
        "id": player["id"],
        "name": player["name"],
        "nationality": player["nationality"],
        "level": player["level"],
        "position": player["position"],
        "status": player["status"],

        # مهم:
        # لا نضع رابط صورة وهمي مبني على رقم اللاعب.
        # نخليه فارغًا مؤقتًا حتى نربطه بـ API ID الحقيقي.
        "image": ""
    })


# =========================================================
# حفظ الملف
# =========================================================

with open("popular_players.json", "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)


