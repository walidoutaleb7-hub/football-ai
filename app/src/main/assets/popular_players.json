# =============================================
# إنشاء قاعدة البيانات بالشكل المطلوب
# =============================================
result = []

for idx, (name, nationality, level) in enumerate(players_data, start=1):
    # رابط صورة افتراضي (يظهر وجهاً بشرياً عشوائياً)
    # 👇 يمكنك استبدال هذا الرابط لاحقاً بصورة حقيقية للاعب
    image_url = f"https://i.pravatar.cc/300?img={idx}"
    
    result.append({
        "id": idx,
        "name": name,
        "nationality": nationality,  # هذا الحقل سيُستخدم في التلميح داخل اللعبة
        "level": level,             # احتفظنا به للاستخدامات المستقبلية
        "image": image_url
    })

# خلط اللاعبين عشوائياً (لإضافة التحدي)
random.shuffle(result)

# إعادة ترقيم المعرفات (ID) بعد الخلط
for new_idx, player in enumerate(result, start=1):
    player["id"] = new_idx

# حفظ الملف
with open("popular_players.json", "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

print(f"✅ تم إنشاء {len(result)} لاعب بنجاح في ملف 'popular_players.json'.")
print("💡 الآن أصبح الملف متوافقاً تماماً مع كود HTML الخاص بك.")