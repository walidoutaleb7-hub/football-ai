        {"id": 1, "name": "كريستيانو رونالدو", "nationality": "البرتغال", "level": "easy",
         "image": "https://media.api-sports.io/football/players/257.png"},
        {"id": 2, "name": "ليونيل ميسي", "nationality": "الأرجنتين", "level": "easy",
         "image": "https://media.api-sports.io/football/players/154.png"},
        {"id": 3, "name": "كيليان مبابي", "nationality": "فرنسا", "level": "easy",
         "image": "https://media.api-sports.io/football/players/278.png"},
        # ... إلخ (يمكن إضافة المزيد يدوياً)
    ]
    with open('popular_players.json', 'w', encoding='utf-8') as f:
        json.dump(FALLBACK, f, ensure_ascii=False, indent=2)
    print(f"✅ تم حفظ {len(FALLBACK)} لاعباً احتياطياً")
    exit(0)

# قائمة الدوريات (7 دوريات كبرى)
LEAGUES = [
    {'id': 39, 'name': 'الدوري الإنجليزي'},   # Premier League
    {'id': 140, 'name': 'الدوري الإسباني'},    # La Liga
    {'id': 135, 'name': 'الدوري الإيطالي'},    # Serie A
    {'id': 78, 'name': 'الدوري الألماني'},     # Bundesliga
    {'id': 61, 'name': 'الدوري الفرنسي'},      # Ligue 1
    {'id': 307, 'name': 'الدوري السعودي'},     # Saudi Pro League (يضم رونالدو)
    {'id': 253, 'name': 'الدوري الأمريكي'},    # MLS (يضم ميسي)
]

SEASON = 2024

# قوائم التصنيف حسب الشهرة (وليس المهارة)
EASY = [
    "كريستيانو رونالدو", "ليونيل ميسي", "كيليان مبابي", "إيرلينغ هالاند",
    "نيمار", "محمد صلاح", "فينيسيوس جونيور", "جود بيلينغهام",
    "روبرت ليفاندوفسكي", "كيفن دي بروين", "لوكا مودريتش",
    "سيرجيو راموس", "كريم بنزيما", "أنطوان غريزمان", "هاري كين",
    "سون هيونغ مين", "برونو فيرنانديز", "بول بوغبا", "تيبو كورتوا"
]

MEDIUM = [
    "بوكايو ساكا", "فيل فودين", "مارتن أوديغارد", "ديكلان رايس",
    "رودري", "لاوتارو مارتينيز", "نيكولو باريلا", "فيدي فالفيردي",
    "جمال موسيالا", "فلوريان فيرتز", "برناردو سيلفا", "رافائيل لياو",
    "ألكسندر إيساك", "جوليان ألفاريز", "إنزو فيرنانديز", "مويسيس كايسيدو"
]

HARD = [
    "دومينيك سوبوسلاي", "ويليام ساليبا", "إبراهيما كوناتي",
    "رونالد أراوخو", "جيريمي فريمبونغ", "أندريه أونانا",
    "فيديريكو ديماركو", "ماتيو كوفاسيتش", "أليكسيس ماك أليستر",
    "جوناثان ديفيد", "لويس أوبيندا", "إدريسا غي"
]

LEGEND = [
    "زين الدين زيدان", "رونالدينيو", "رونالدو نازاريو", "ريفالدو",
    "كاكا", "أندريا بيرلو", "تشافي", "أندريس إنييستا",
    "فرانك لامبارد", "ستيفن جيرارد", "تييري هنري", "باولو مالديني"
]

all_players = []
seen = set()

print('🔄 جاري تحميل اللاعبين من جميع الدوريات...')

for league in LEAGUES:
    try:
        url = f'https://v3.football.api-sports.io/players?league={league["id"]}&season={SEASON}'
        headers = {'x-apisports-key': API_KEY}
        r = requests.get(url, headers=headers, timeout=10)
        if r.status_code != 200:
            print(f'⚠️ فشل تحميل {league["name"]}')
            continue
        data = r.json()
        for p in data.get('response', []):
            player = p.get('player', {})
            name = player.get('name')
            photo = player.get('photo')
            if not name or not photo or name in seen:
                continue
            seen.add(name)

            # تصنيف الصعوبة حسب الشهرة
            level = 'easy'
            if name in LEGEND:
                level = 'legend'
            elif name in HARD:
                level = 'hard'
            elif name in MEDIUM:
                level = 'medium'
            elif name in EASY:
                level = 'easy'

            all_players.append({
                'id': player.get('id'),
                'name': name,
                'nationality': player.get('nationality', 'غير معروف'),
                'level': level,
                'image': photo
            })
        print(f'✅ {league["name"]}: {len(all_players)} لاعب حتى الآن')
    except Exception as e:
        print(f'❌ خطأ في {league["name"]}: {e}')

# إذا كان عدد اللاعبين أقل من 500، حاول جلب لاعبين إضافيين من دوريات أخرى
if len(all_players) < 500:
    print(f"⚠️ العدد الحالي: {len(all_players)} لاعب، أقل من 500. جلب لاعبين إضافيين...")
    extra_leagues = [
        {'id': 71, 'name': 'الدوري البرازيلي'},
        {'id': 94, 'name': 'الدوري البرتغالي'},
        {'id': 72, 'name': 'الدوري الهولندي'},
    ]
    for league in extra_leagues:
        try:
            url = f'https://v3.football.api-sports.io/players?league={league["id"]}&season={SEASON}'
            headers = {'x-apisports-key': API_KEY}
            r = requests.get(url, headers=headers, timeout=10)
            if r.status_code != 200:
                continue
            data = r.json()
            for p in data.get('response', []):
                player = p.get('player', {})
                name = player.get('name')
                photo = player.get('photo')
                if not name or not photo or name in seen:
                    continue
                seen.add(name)
                # اللاعبين الإضافيين نصنفهم كـ 'medium' افتراضياً
                all_players.append({
                    'id': player.get('id'),
                    'name': name,
                    'nationality': player.get('nationality', 'غير معروف'),
                    'level': 'medium',
                    'image': photo
                })
            print(f'✅ {league["name"]}: {len(all_players)} لاعب حتى الآن')
        except Exception as e:
            print(f'❌ خطأ في {league["name"]}: {e}')

# إذا فشل كل شيء أو العدد لا يزال قليلاً
if len(all_players) < 50:
    print("⚠️ فشل تحميل كافٍ من اللاعبين. استخدام بيانات احتياطية محدودة.")
    # بيانات احتياطية (50 لاعباً مشهوراً) في حال فشل API تماماً
    FALLBACK = [
        {"id": 1, "name": "كريستيانو رونالدو", "nationality": "البرتغال", "level": "easy",
         "image": "https://media.api-sports.io/football/players/257.png"},
        {"id": 2, "name": "ليونيل ميسي", "nationality": "الأرجنتين", "level": "easy",
         "image": "https://media.api-sports.io/football/players/154.png"},
        {"id": 3, "name": "كيليان مبابي", "nationality": "فرنسا", "level": "easy",
         "image": "https://media.api-sports.io/football/players/278.png"},
        {"id": 4, "name": "إيرلينغ هالاند", "nationality": "النرويج", "level": "easy",
         "image": "https://media.api-sports.io/football/players/1100.png"},
        {"id": 5, "name": "محمد صلاح", "nationality": "مصر", "level": "easy",
         "image": "https://media.api-sports.io/football/players/306.png"},
        # يمكن إضافة المزيد...
    ]
    all_players = FALLBACK

# خلط اللاعبين
random.shuffle(all_players)

# إعادة ترقيم المعرفات
for i, p in enumerate(all_players, 1):
    p["id"] = i

# حفظ الملف
with open('popular_players.json', 'w', encoding='utf-8') as f:
    json.dump(all_players, f, ensure_ascii=False, indent=2)

print(f'✅ تم حفظ {len(all_players)} لاعباً بنجاح!')
if len(all_players) >= 500:
    print('🎉 تم تحقيق الهدف: أكثر من 500 لاعب!')
else:
    print(f'⚠️ العدد النهائي: {len(all_players)} لاعب. قد تحتاج إلى تحسين الاتصال بالـ API.')